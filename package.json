{
	"name": "editor",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"check-types:fumadocs": "pnpm --filter fumadocs run types:check",
		"check:packages": "pnpm -r --filter \"./packages/*\" run check:package",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"test:browser": "playwright test",
		"check": "biome check --write .",
		"check:ci": "biome ci .",
		"lint:staged": "lint-staged",
		"prepare": "husky"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.12",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@editor/config": "workspace:*",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.4.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.34.5"
}
