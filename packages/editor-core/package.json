{
	"name": "@rumahkodingku/editor-core",
	"version": "0.0.0",
	"description": "Framework-independent core for RumahKodingku Editor.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RumahKodingku/editor.git",
		"directory": "packages/editor-core"
	},
	"homepage": "https://github.com/RumahKodingku/editor#readme",
	"bugs": {
		"url": "https://github.com/RumahKodingku/editor/issues"
	},
	"keywords": [
		"tiptap",
		"prosemirror",
		"rich-text-editor",
		"wysiwyg",
		"editor"
	],
	"sideEffects": false,
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"check-types": "tsc --noEmit",
		"check:package": "publint && attw --pack . --profile esm-only"
	},
	"peerDependencies": {
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-image": "^3.31.4",
		"@tiptap/extensions": "^3.31.4",
		"@tiptap/html": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"happy-dom": "^20.8.9"
	},
	"peerDependenciesMeta": {
		"happy-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@editor/config": "workspace:*",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-image": "^3.31.4",
		"@tiptap/extensions": "^3.31.4",
		"@tiptap/html": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"@types/node": "^26.4.1",
		"@vitest/coverage-v8": "^5.0.2",
		"happy-dom": "^20.8.9",
		"jsdom": "^30.1.1",
		"publint": "^0.3.24",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
