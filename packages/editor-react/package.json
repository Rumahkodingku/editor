{
	"name": "@rumahkodingku/editor-react",
	"version": "0.0.0",
	"description": "React adapter for RumahKodingku Editor.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RumahKodingku/editor.git",
		"directory": "packages/editor-react"
	},
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"check-types": "tsc --noEmit",
		"check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css"
	},
	"dependencies": {
		"@rumahkodingku/editor-core": "workspace:*"
	},
	"peerDependencies": {
		"@tiptap/react": "^3.31.4",
		"react": "^19",
		"react-dom": "^19"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@editor/config": "workspace:*",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@tiptap/react": "^3.31.4",
		"@types/node": "^26.4.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.2",
		"jsdom": "^30.1.1",
		"publint": "^0.3.24",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
